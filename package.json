{
  "name": "@crypto-jambot/secret-manager-utils",
  "version": "1.1.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "start": "node .",
    "build": "tsc -p tsconfig.build.json && npm run moveMissingFiles",
    "dev": "nodemon src/server.ts",
    "patch": "npm version patch --git-tag-version",
    "moveMissingFiles": "cp src/*.d.ts dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crypto-jambot/secret-manager-utils.git"
  },
  "keywords": [],
  "author": "",
