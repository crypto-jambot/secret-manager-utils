  "bugs": {
    "url": "https://github.com/crypto-jambot/secret-manager-utils/issues"
  },
  "homepage": "https://github.com/crypto-jambot/secret-manager-utils#readme",
  "dependencies": {
    "@google-cloud/secret-manager": "^4.1.4"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
